          }
        }
      ]
    },
    {
      "id": "concurrency-order-independent",
      "family": "concurrency",
      "version": "complex-fixture-v1",
      "requirement": "Concurrent order does not change the canonical result.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "Arrival order chooses a non-canonical winner.",
      "checks": [
        {
          "name": "canonical-order",
          "operations": [
