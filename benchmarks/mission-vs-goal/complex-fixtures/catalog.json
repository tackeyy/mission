{
  "schema": "mission-complex-fixtures/1",
  "tasks": [
    {
      "id": "multi-module-cache",
      "family": "multi_module",
      "version": "complex-fixture-v1",
      "requirement": "A cache invalidation crosses parser and service modules.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A write returns a stale cached value after an update.",
      "checks": [
        {
          "name": "replace-cache",
          "operations": [
            {
              "kind": "write",
              "key": "x",
              "value": 1
            },
            {
              "kind": "write",
              "key": "x",
              "value": 2
            }
          ],
          "expected": {
            "items": {
              "x": 2
            },
            "sent": [],
            "total": 0
          }
        }
      ]
    },
    {
      "id": "multi-module-unit-boundary",
      "family": "multi_module",
      "version": "complex-fixture-v1",
      "requirement": "A boundary conversion preserves currency units across modules.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A cents value is exposed as whole currency.",
      "checks": [
        {
          "name": "cents-boundary",
          "operations": [
            {
              "kind": "amount",
              "cents": 1250
            }
          ],
          "expected": {
            "items": {
              "amount": 12.5
            },
            "sent": [],
            "total": 0
          }
        }
      ]
    },
    {
      "id": "compatibility-legacy-default",
      "family": "compatibility",
      "version": "complex-fixture-v1",
      "requirement": "Legacy and current payloads retain their documented default.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A legacy payload loses its compatibility default.",
      "checks": [
        {
          "name": "legacy-default",
          "operations": [
            {
              "kind": "payload"
            }
          ],
          "expected": {
            "items": {
              "state": "open"
            },
            "sent": [],
            "total": 0
          }
        }
      ]
    },
    {
      "id": "compatibility-versioned-field",
      "family": "compatibility",
      "version": "complex-fixture-v1",
      "requirement": "A versioned boundary maps an old field to its current meaning.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A renamed field is silently ignored by the current consumer.",
      "checks": [
        {
          "name": "renamed-field",
          "operations": [
            {
              "kind": "payload",
              "urgency": "high"
            }
          ],
          "expected": {
            "items": {
              "priority": "high"
            },
            "sent": [],
            "total": 0
          }
        }
      ]
    },
    {
      "id": "partial-failure-rollback",
      "family": "partial_failure",
      "version": "complex-fixture-v1",
      "requirement": "A failed batch does not leave partial persistent state.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A partial write remains visible after a later operation fails.",
      "checks": [
        {
          "name": "atomic-failure",
          "operations": [
            {
              "kind": "put",
              "key": "a",
              "value": 1
            },
            {
              "kind": "fail"
            }
          ],
          "expected": {
            "items": {},
            "sent": [],
            "total": 0
          }
        }
      ]
    },
    {
      "id": "partial-failure-selective-retry",
      "family": "partial_failure",
      "version": "complex-fixture-v1",
      "requirement": "A retry executes only operations that were not accepted.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A retry repeats an already accepted external operation.",
      "checks": [
        {
          "name": "selective-retry",
          "operations": [
            {
              "kind": "send",
              "id": "a"
            },
            {
              "kind": "send",
              "id": "a"
            },
            {
              "kind": "send",
              "id": "b"
            }
          ],
          "expected": {
            "items": {},
            "sent": [
              "a",
              "b"
            ],
            "total": 0
          }
        }
      ]
    },
    {
      "id": "rerun-idempotency-key",
      "family": "rerun",
      "version": "complex-fixture-v1",
      "requirement": "Replaying the same event preserves one logical effect.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A repeated event is charged twice.",
      "checks": [
        {
          "name": "same-event",
          "operations": [
            {
              "kind": "charge",
              "id": "x",
              "amount": 3
            },
            {
              "kind": "charge",
              "id": "x",
              "amount": 3
            }
          ],
          "expected": {
            "items": {},
            "sent": [],
            "total": 3
          }
        }
      ]
    },
    {
      "id": "rerun-resume-watermark",
      "family": "rerun",
      "version": "complex-fixture-v1",
      "requirement": "Resume starts after the persisted watermark.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "Resume processes the previously committed item again.",
      "checks": [
        {
          "name": "watermark",
          "operations": [
            {
              "kind": "event",
              "id": "a",
              "offset": 1
            },
            {
              "kind": "event",
              "id": "b",
              "offset": 1
            },
            {
              "kind": "event",
              "id": "c",
              "offset": 2
            }
          ],
          "expected": {
            "items": {},
            "sent": [
              "a",
              "c"
            ],
            "total": 0
          }
        }
      ]
    },
    {
