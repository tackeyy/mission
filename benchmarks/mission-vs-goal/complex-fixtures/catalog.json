{
  "schema": "mission-complex-fixtures/1",
  "tasks": [
    {
      "id": "multi-module-cache",
      "family": "multi_module",
      "version": "complex-fixture-v1",
      "requirement": "A cache invalidation crosses parser and service modules.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A write returns a stale cached value after an update.",
      "checks": [
        {
          "name": "read-write-read",
          "scenario": {
            "initial": {
              "x": 1
            },
            "operations": [
              {
                "kind": "read",
                "key": "x"
              },
              {
                "kind": "write",
                "key": "x",
                "value": 2
              },
              {
                "kind": "read",
                "key": "x"
              }
            ]
          },
          "expected": {
            "values": [
              1,
              2
            ],
            "state": {
              "x": 2
            }
          }
        },
        {
          "name": "independent-key",
          "scenario": {
            "initial": {
              "x": 1,
              "y": 4
            },
            "operations": [
              {
                "kind": "read",
                "key": "y"
              },
              {
                "kind": "write",
                "key": "x",
                "value": 7
              },
              {
                "kind": "read",
                "key": "y"
              },
              {
                "kind": "read",
                "key": "x"
              }
            ]
          },
          "expected": {
            "values": [
              4,
              4,
              7
            ],
            "state": {
              "x": 7,
              "y": 4
            }
          }
        },
        {
          "name": "two-updates",
          "scenario": {
            "initial": {
              "x": 3
            },
            "operations": [
              {
                "kind": "read",
                "key": "x"
              },
              {
                "kind": "write",
                "key": "x",
                "value": 5
              },
              {
                "kind": "read",
                "key": "x"
              },
              {
                "kind": "write",
                "key": "x",
                "value": 9
              },
              {
                "kind": "read",
                "key": "x"
              }
            ]
          },
          "expected": {
            "values": [
              3,
              5,
              9
            ],
            "state": {
              "x": 9
            }
          }
        }
      ]
    },
    {
      "id": "multi-module-unit-boundary",
      "family": "multi_module",
      "version": "complex-fixture-v1",
      "requirement": "A boundary conversion preserves currency units across modules.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A cents value is exposed as whole currency.",
      "checks": [
        {
          "name": "major-with-fee",
          "scenario": {
            "payload": {
              "amount": 12.5,
              "unit": "major"
            },
            "fee_minor": 25
          },
          "expected": {
            "minor_total": 1275,
            "display_major": 12.75
          }
        },
        {
          "name": "minor-with-fee",
          "scenario": {
            "payload": {
              "amount": 1250,
              "unit": "minor"
            },
            "fee_minor": 50
          },
          "expected": {
            "minor_total": 1300,
            "display_major": 13.0
          }
        },
        {
          "name": "fractional-major",
          "scenario": {
            "payload": {
              "amount": 0.75,
              "unit": "major"
            },
            "fee_minor": 5
          },
          "expected": {
            "minor_total": 80,
            "display_major": 0.8
          }
        }
      ]
    },
    {
      "id": "compatibility-legacy-default",
      "family": "compatibility",
      "version": "complex-fixture-v1",
      "requirement": "Legacy and current payloads retain their documented default.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A legacy payload loses its compatibility default.",
      "checks": [
        {
          "name": "legacy-default",
          "scenario": {
            "version": 1
          },
          "expected": {
            "state": "open",
            "version": 1
          }
        },
        {
          "name": "current-default",
          "scenario": {
            "version": 2
          },
          "expected": {
            "state": "pending",
            "version": 2
          }
        },
        {
          "name": "explicit-state",
          "scenario": {
            "version": 1,
            "state": "closed"
          },
          "expected": {
            "state": "closed",
            "version": 1
          }
        }
      ]
    },
    {
      "id": "compatibility-versioned-field",
      "family": "compatibility",
      "version": "complex-fixture-v1",
      "requirement": "A versioned boundary maps an old field to its current meaning.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A renamed field is silently ignored by the current consumer.",
      "checks": [
        {
          "name": "legacy-urgency",
          "scenario": {
            "urgency": "high"
          },
          "expected": {
            "priority": "high"
          }
        },
        {
          "name": "current-priority",
          "scenario": {
            "priority": "low"
          },
          "expected": {
            "priority": "low"
          }
        },
        {
          "name": "explicit-current-wins",
          "scenario": {
            "priority": "low",
            "urgency": "high"
          },
          "expected": {
            "priority": "low"
          }
        }
      ]
    },
    {
      "id": "partial-failure-rollback",
      "family": "partial_failure",
      "version": "complex-fixture-v1",
      "requirement": "A failed batch does not leave partial persistent state.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A partial write remains visible after a later operation fails.",
      "checks": [
        {
          "name": "preserve-existing-on-first-fault",
          "scenario": {
            "existing": {
              "keep": 9
            },
            "writes": [
              {
                "key": "new",
                "value": 1
              }
            ],
            "fail_after": 0
          },
          "expected": {
            "committed": false,
            "state": {
              "keep": 9
            }
          }
        },
        {
          "name": "commit-whole-batch",
          "scenario": {
            "existing": {
              "keep": 9
            },
            "writes": [
              {
                "key": "a",
                "value": 1
              },
              {
                "key": "b",
                "value": 2
              }
            ],
            "fail_after": null
          },
          "expected": {
            "committed": true,
            "state": {
              "keep": 9,
              "a": 1,
              "b": 2
            }
          }
        },
        {
          "name": "preserve-existing-on-late-fault",
          "scenario": {
            "existing": {
              "prior": 4
            },
            "writes": [
              {
                "key": "a",
                "value": 1
              },
              {
                "key": "b",
                "value": 2
              }
            ],
            "fail_after": 1
          },
          "expected": {
            "committed": false,
            "state": {
              "prior": 4
            }
          }
        }
      ]
    },
    {
      "id": "partial-failure-selective-retry",
      "family": "partial_failure",
      "version": "complex-fixture-v1",
      "requirement": "A retry executes only operations that were not accepted.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A retry repeats an already accepted external operation.",
      "checks": [
        {
          "name": "skip-accepted",
          "scenario": {
            "accepted": [
              "a"
            ],
            "rounds": [
              [
                "a",
                "b"
              ]
            ],
            "fail_once": []
          },
          "expected": {
            "attempts": [
              "b"
            ],
            "accepted": [
              "a",
              "b"
            ]
          }
        },
        {
          "name": "retry-only-failed",
          "scenario": {
            "accepted": [
              "a"
            ],
            "rounds": [
              [
                "a",
                "b",
                "c"
              ],
              [
                "b"
              ]
            ],
            "fail_once": [
              "b"
            ]
          },
          "expected": {
            "attempts": [
              "b",
              "c",
              "b"
            ],
            "accepted": [
              "a",
              "b",
              "c"
            ]
          }
        },
        {
          "name": "retain-two-accepted",
          "scenario": {
            "accepted": [
              "a",
              "c"
            ],
            "rounds": [
              [
                "a",
                "b",
                "c"
              ],
              [
                "b"
              ]
            ],
            "fail_once": []
          },
          "expected": {
            "attempts": [
              "b"
            ],
            "accepted": [
              "a",
              "b",
              "c"
            ]
          }
        }
      ]
    },
    {
      "id": "rerun-idempotency-key",
      "family": "rerun",
      "version": "complex-fixture-v1",
      "requirement": "Replaying the same event preserves one logical effect.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A repeated event is charged twice.",
      "checks": [
        {
          "name": "same-event",
          "scenario": {
            "state": {},
            "calls": [
              {
                "event": {
                  "id": "a",
                  "amount": 3
                }
              },
              {
                "event": {
                  "id": "a",
                  "amount": 3
                }
              }
            ]
          },
          "expected": {
            "effects": {
              "a": 3
            },
            "total": 3
          }
        },
        {
          "name": "reload-retains-effect",
          "scenario": {
            "state": {},
            "calls": [
              {
                "event": {
                  "id": "a",
                  "amount": 3
                },
                "reload": true
              },
              {
                "event": {
                  "id": "a",
                  "amount": 3
                }
              }
            ]
          },
          "expected": {
            "effects": {
              "a": 3
            },
            "total": 3
          }
        },
        {
          "name": "persisted-plus-new",
          "scenario": {
            "state": {
              "a": 3
            },
            "calls": [
              {
                "event": {
                  "id": "a",
                  "amount": 3
                }
              },
              {
                "event": {
                  "id": "b",
                  "amount": 5
                },
                "reload": true
              }
            ]
          },
          "expected": {
            "effects": {
              "a": 3,
              "b": 5
            },
            "total": 8
          }
        }
      ]
    },
    {
      "id": "rerun-resume-watermark",
      "family": "rerun",
      "version": "complex-fixture-v1",
      "requirement": "Resume starts after the persisted watermark.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "Resume processes the previously committed item again.",
      "checks": [
        {
          "name": "skip-persisted-watermark",
          "scenario": {
            "state": {
              "watermark": 1,
              "processed": [
                "a"
              ]
            },
            "runs": [
              {
                "events": [
                  {
                    "id": "b",
                    "offset": 1
                  },
                  {
                    "id": "c",
                    "offset": 2
                  }
                ]
              }
            ]
          },
          "expected": {
            "watermark": 2,
            "processed": [
              "a",
              "c"
            ]
          }
        },
        {
          "name": "reload-between-runs",
          "scenario": {
            "state": {},
            "runs": [
              {
                "events": [
                  {
                    "id": "a",
                    "offset": 1
                  }
                ],
                "reload": true
              },
              {
                "events": [
                  {
                    "id": "b",
                    "offset": 1
                  },
                  {
                    "id": "c",
                    "offset": 2
                  }
                ]
              }
            ]
          },
          "expected": {
            "watermark": 2,
            "processed": [
              "a",
              "c"
            ]
          }
        },
        {
          "name": "continue-after-watermark",
          "scenario": {
            "state": {
              "watermark": 2,
              "processed": [
                "a",
                "b"
              ]
            },
            "runs": [
              {
                "events": [
                  {
                    "id": "c",
                    "offset": 3
                  },
                  {
                    "id": "d",
                    "offset": 4
                  }
                ],
                "reload": true
              }
            ]
          },
          "expected": {
            "watermark": 4,
            "processed": [
              "a",
              "b",
              "c",
              "d"
            ]
          }
        }
      ]
    },
    {
      "id": "aggregation-cancellation",
      "family": "aggregation",
      "version": "complex-fixture-v1",
      "requirement": "Cancellation is reflected in the aggregate state.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A cancellation leaves an obsolete positive total.",
      "checks": [
        {
          "name": "cancel-one-keeps-other",
          "scenario": {
            "events": [
              {
                "kind": "add",
                "id": "a",
                "amount": 5
              },
              {
                "kind": "add",
                "id": "b",
                "amount": 3
              },
              {
                "kind": "cancel",
                "id": "a"
              }
            ]
          },
          "expected": {
            "entries": {
              "b": 3
            },
            "total": 3
          }
        },
        {
          "name": "unknown-cancel",
          "scenario": {
            "events": [
              {
                "kind": "add",
                "id": "a",
                "amount": 2
              },
              {
                "kind": "cancel",
                "id": "missing"
              }
            ]
          },
          "expected": {
            "entries": {
              "a": 2
            },
            "total": 2
          }
        },
        {
          "name": "order-with-three-ids",
          "scenario": {
            "events": [
              {
                "kind": "add",
                "id": "a",
                "amount": 1
              },
              {
                "kind": "add",
                "id": "b",
                "amount": 4
              },
              {
                "kind": "cancel",
                "id": "b"
              },
              {
                "kind": "add",
                "id": "c",
                "amount": 2
              }
            ]
          },
          "expected": {
            "entries": {
              "a": 1,
              "c": 2
            },
            "total": 3
          }
        }
      ]
    },
    {
      "id": "aggregation-deduplication",
      "family": "aggregation",
      "version": "complex-fixture-v1",
      "requirement": "Duplicate delivery does not inflate an aggregate.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "A duplicate event is counted twice.",
      "checks": [
        {
          "name": "duplicate-one",
          "scenario": {
            "events": [
              {
                "id": "a",
                "amount": 2
              },
              {
                "id": "a",
                "amount": 2
              }
            ]
          },
          "expected": {
            "entries": {
              "a": 2
            },
            "total": 2
          }
        },
        {
          "name": "interleaved-duplicates",
          "scenario": {
            "events": [
              {
                "id": "a",
                "amount": 2
              },
              {
                "id": "b",
                "amount": 3
              },
              {
                "id": "a",
                "amount": 2
              }
            ]
          },
          "expected": {
            "entries": {
              "a": 2,
              "b": 3
            },
            "total": 5
          }
        },
        {
          "name": "duplicate-after-new",
          "scenario": {
            "events": [
              {
                "id": "c",
                "amount": 1
              },
              {
                "id": "c",
                "amount": 1
              },
              {
                "id": "a",
                "amount": 4
              }
            ]
          },
          "expected": {
            "entries": {
              "c": 1,
              "a": 4
            },
            "total": 5
          }
        }
      ]
    },
    {
      "id": "concurrency-lost-update",
      "family": "concurrency",
      "version": "complex-fixture-v1",
      "requirement": "A deterministic barrier preserves both concurrent increments.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "Two writers read the same value and one increment is lost.",
      "checks": [
        {
          "name": "zero-plus-one-plus-one",
          "scenario": {
            "initial": 0,
            "deltas": [
              1,
              1
            ]
          },
          "expected": {
            "final_state": 2,
            "threads_completed": 2
          }
        },
        {
          "name": "seven-plus-two-plus-five",
          "scenario": {
            "initial": 7,
            "deltas": [
              2,
              5
            ]
          },
          "expected": {
            "final_state": 14,
            "threads_completed": 2
          }
        },
        {
          "name": "negative-three-plus-four-minus-two",
          "scenario": {
            "initial": -3,
            "deltas": [
              4,
              -2
            ]
          },
          "expected": {
            "final_state": -1,
            "threads_completed": 2
          }
        }
      ]
    },
    {
      "id": "concurrency-order-independent",
      "family": "concurrency",
      "version": "complex-fixture-v1",
      "requirement": "Concurrent order does not change the canonical result.",
      "dependency": "boundary.py -> service.py",
      "realistic_failure": "Arrival order chooses a non-canonical winner.",
      "checks": [
        {
          "name": "z-over-a-by-rank",
          "scenario": {
            "candidates": [
              {
                "id": "z",
                "rank": 1
              },
              {
                "id": "a",
                "rank": 2
              }
            ],
            "arrival_order": [
              "a",
              "z"
            ]
          },
          "expected": {
            "winner": {
              "id": "z",
              "rank": 1
            },
            "threads_completed": 2
          }
        },
        {
          "name": "b-over-c-by-rank",
          "scenario": {
            "candidates": [
              {
                "id": "b",
                "rank": 1
              },
              {
                "id": "c",
                "rank": 2
              }
            ],
            "arrival_order": [
              "c",
              "b"
            ]
          },
          "expected": {
            "winner": {
              "id": "b",
              "rank": 1
            },
            "threads_completed": 2
          }
        },
        {
          "name": "same-rank-id-tie-break-in-reverse-arrival-order",
          "scenario": {
            "candidates": [
              {
                "id": "a",
                "rank": 4
              },
              {
                "id": "z",
                "rank": 4
              }
            ],
            "arrival_order": [
              "a",
              "z"
            ]
          },
          "expected": {
            "winner": {
              "id": "a",
              "rank": 4
            },
            "threads_completed": 2
          }
        }
      ]
    }
  ]
}
