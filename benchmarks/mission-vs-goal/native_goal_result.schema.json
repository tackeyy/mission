{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native Goal benchmark result",
  "type": "object",
  "required": ["schema", "run_id", "task_id", "arm", "outcome", "fidelity", "manifest"],
  "properties": {
    "schema": {"const": "native-goal-benchmark-result/1"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "arm": {"enum": ["codex_native_goal", "claude_code_native_goal", "mission"]},
    "outcome": {"enum": ["completed", "failed", "blocked", "unsupported", "not_started"]},
    "fidelity": {"enum": ["verified", "unverified", "not_applicable"]},
    "reason": {"type": ["string", "null"]},
    "manifest": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"fidelity": {"const": "verified"}}, "required": ["fidelity"]},
      "then": {"properties": {"manifest": {"required": ["package", "source", "task_snapshot", "provider_version", "conditions", "worker_export"], "properties": {"package": {"required": ["sha256"]}, "source": {"required": ["sha256"]}, "task_snapshot": {"required": ["expected", "observed", "clean", "matches"]}, "conditions": {"required": ["model_id", "effort", "permissions"]}, "worker_export": {"required": ["schema", "sha256", "source_commit", "allowlist_count"]}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "completed"}}, "required": ["outcome"]},
      "then": {"properties": {"manifest": {"required": ["package", "source", "task_snapshot", "provider_version", "conditions", "worker_export"], "properties": {"package": {"required": ["sha256"]}, "source": {"required": ["sha256"]}, "task_snapshot": {"required": ["expected", "observed", "clean", "matches"]}, "conditions": {"required": ["model_id", "effort", "permissions"]}, "worker_export": {"required": ["schema", "sha256", "source_commit", "allowlist_count"]}}}}}
    }
  ],
  "additionalProperties": true
}
